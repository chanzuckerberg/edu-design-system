exports[`<Markdown /> GithubFlavoredMarkdown story renders snapshot 1`] = `
<div
  class="markdown"
>
  <h1
    class="text text--headline-lg"
  >
    GitHub-Flavored Markdown
  </h1>
  

  <h2
    class="text text--headline-md"
  >
    Tables
  </h2>
  

  <p
    class="text text--body-md"
  >
    GitHub-flavored markdown supports basic tables. Alignment can be controlled for each column. 
    <a
      class="link link--emphasis-default"
      href="https://docs.github.com/en/get-started/writing-on-github/working-with-advanced-formatting/organizing-information-with-tables"
    >
      See doc.s
    </a>
    .
  </p>
  

  <table
    class="markdown__table"
  >
    <thead
      class="markdown__thead"
    >
      <tr
        class="markdown__tr"
      >
        <th
          class="markdown__th"
        >
          a
        </th>
        <th
          align="left"
          class="markdown__th"
        >
          b
        </th>
        <th
          align="right"
          class="markdown__th"
        >
          c
        </th>
        <th
          align="center"
          class="markdown__th"
        >
          d
        </th>
      </tr>
    </thead>
    <tbody>
      <tr
        class="markdown__tr"
      >
        <td
          class="markdown__td"
        >
          1
        </td>
        <td
          align="left"
          class="markdown__td"
        >
          2
        </td>
        <td
          align="right"
          class="markdown__td"
        >
          3
        </td>
        <td
          align="center"
          class="markdown__td"
        >
          4
        </td>
      </tr>
    </tbody>
  </table>
</div>
`;
